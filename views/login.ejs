<section class="hero" style="padding:56px 20px">
  <h1 style="font-size:1.8rem;margin:0">🔐 Log in</h1>
  <p class="tagline">Sign in to manage your paired devices and Favorites.</p>

  <% if (error) { %><div class="pair-result err" style="max-width:360px"><%= error %></div><% } %>

  <form method="post" action="/login" class="auth-form">
    <input type="email" name="email" placeholder="Email" autocomplete="email" required />
    <input type="password" name="password" placeholder="Password" autocomplete="current-password" required />
    <button class="btn primary" type="submit">Log in</button>
  </form>
</section>
