<section class="hero" style="padding:56px 20px">
  <h1 style="font-size:1.8rem;margin:0">🛠 First-time setup</h1>
  <p class="tagline">Create the Owner account for this KitsuNexus server. This runs once — after this, sign-in happens on the Log in page. Public registration isn't enabled yet.</p>

  <% if (error) { %><div class="pair-result err" style="max-width:360px"><%= error %></div><% } %>

  <form method="post" action="/setup" class="auth-form">
    <input type="text" name="displayName" placeholder="Display name" autocomplete="name" />
    <input type="email" name="email" placeholder="Email" autocomplete="email" required />
    <input type="password" name="password" placeholder="Password (min 8 characters)" autocomplete="new-password" required />
    <input type="password" name="confirmPassword" placeholder="Confirm password" autocomplete="new-password" required />
    <button class="btn primary" type="submit">Create Owner account</button>
  </form>
</section>
