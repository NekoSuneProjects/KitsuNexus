<section class="auth-page">
  <div class="auth-card">
    <div class="auth-icon">✨</div>
    <h1>Create an account</h1>
    <p class="auth-sub">Sign up to sync your KitsuNexus Favorites across devices and link Discord.</p>

    <% if (error) { %><div class="pair-result err" style="max-width:none;margin-bottom:14px"><%= error %></div><% } %>

    <% if (zitadelEnabled) { %>
      <a class="btn sso" href="/auth/zitadel/login">🛡 Sign up with NekoSuneVR SSO</a>
      <div class="auth-divider">or</div>
    <% } %>

    <form method="post" action="/register" class="auth-form">
      <input type="text" name="displayName" placeholder="Display name" autocomplete="name" autofocus />
      <input type="email" name="email" placeholder="Email" autocomplete="email" required />
      <input type="password" name="password" placeholder="Password (min 8 characters)" autocomplete="new-password" required />
      <input type="password" name="confirmPassword" placeholder="Confirm password" autocomplete="new-password" required />
      <button class="btn primary" type="submit">Create account</button>
    </form>
    <div class="auth-links">Already have an account? <a href="/login">Log in</a></div>
  </div>
</section>
