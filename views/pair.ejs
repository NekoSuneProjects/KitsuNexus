<section class="auth-page">
  <div class="auth-card">
    <div class="auth-icon">🔗</div>
    <h1>Connect a device</h1>
    <p class="auth-sub">Open KitsuNexus on your desktop, go to Settings ▸ Cloud Sync, and enter the 6-character code shown there.</p>

    <% if (result) { %>
      <div class="pair-result <%= result.ok ? 'ok' : 'err' %>" style="max-width:none;margin-bottom:14px"><%= result.message %></div>
    <% } %>

    <form method="post" action="/pair" class="auth-form" style="align-items:center">
      <input type="text" name="code" maxlength="6" placeholder="ABC123" autocomplete="off" autocapitalize="characters" autofocus required
        style="text-align:center;font-size:1.3rem;letter-spacing:.2em;text-transform:uppercase" />
      <button class="btn primary" type="submit">Connect</button>
    </form>
    <div class="auth-links"><a href="/dashboard">← Back to dashboard</a></div>
  </div>
</section>
