<section class="hero" style="padding:56px 20px">
  <h1 style="font-size:1.8rem;margin:0">🔗 Connect a device</h1>
  <p class="tagline">Open KitsuNexus on your desktop, go to Settings ▸ Cloud Sync, and enter the 6-character code shown there.</p>

  <% if (result) { %>
    <div class="pair-result <%= result.ok ? 'ok' : 'err' %>"><%= result.message %></div>
  <% } %>

  <form method="post" action="/pair" class="pair-form">
    <input type="text" name="code" maxlength="6" placeholder="ABC123" autocomplete="off" autocapitalize="characters" required />
    <button class="btn primary" type="submit">Connect</button>
  </form>
</section>
