PORT=8080
# Local dev: http://localhost:8080 (matches docker-compose's host-side port mapping)
# Production: https://kitsunexus.nekosunevr.co.uk — also makes the session cookie "secure"
SITE_URL=http://localhost:8080
# DB_PATH=./data/kitsunexus.sqlite

# How many reverse-proxy hops to trust for X-Forwarded-For (Express "trust proxy" setting).
# Needed so the rate limiter sees each visitor's real IP instead of the proxy's. Default 1
# matches the normal single-reverse-proxy deployment; set to 0 or false if this server is
# reached directly with no proxy in front, or higher if there's more than one hop.
TRUST_PROXY=1

# Required in production — without it, every restart invalidates all logged-in sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Discord bot integration — fully optional. Leave all of these blank to run the site with
# accounts + Favorites sync only; the bot gateway and /oauth2/discord/* routes just report
# "not configured" instead of crashing the server. Create a Discord app at
# https://discord.com/developers/applications to fill these in.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# Must exactly match a redirect registered on the Discord app, e.g.
# https://kitsunexus.nekosunevr.co.uk/oauth2/discord/callback
DISCORD_REDIRECT_URI=
# Optional: GET / could redirect here, unused for now (this server's homepage is its own page).
DISCORD_INVITE_URL=
# Your official Discord server's id (right-click the server icon with Developer Mode on ->
# Copy Server ID). The bot never leaves this guild even if it's not in the usual
# /oauth2/discord/authorize-bot whitelist, and it's the ONLY guild a permanent ban
# (services/banUser.js) ever bans someone from — never every guild the bot happens to be in.
DISCORD_OFFICIAL_GUILD_ID=
# Discord role id -> Community Rank mapping for the guild above, as a JSON object keyed by
# ROLE ID (not rank key). Right-click each role in Server Settings > Roles with Developer Mode
# on to copy its id. Re-synced on every boot — ENV is the source of truth for this one guild;
# self-hosters configure their own guilds through Settings > Discord in the app instead.
# Valid rank keys: new_user, user, known_user, trusted_user, veteran, legend. Example:
# DISCORD_RANK_ROLES={"111111111111111111":"new_user","222222222222222222":"veteran","333333333333333333":"legend"}
DISCORD_RANK_ROLES=

# ZITADEL SSO — fully optional, offered ALONGSIDE email/password (not a replacement). Leave
# ZITADEL_ENABLED unset/false to hide the SSO button everywhere and skip all of this.
# Register a Web application (PKCE + a client secret, "Authorization Code" grant) at your
# ZITADEL console with redirect URI: <SITE_URL>/auth/zitadel/callback
ZITADEL_ENABLED=false
# Issuer origin, no trailing path — e.g. https://oauth2.nekosunevr.co.uk
ZITADEL_ENDPOINT=
ZITADEL_CLIENT_ID=
ZITADEL_CLIENT_SECRET=
# Optional override — defaults to "${SITE_URL}/auth/zitadel/callback". Must exactly match a
# redirect URI registered on the ZITADEL application.
ZITADEL_REDIRECT_URI=
ZITADEL_SCOPES=openid profile email
