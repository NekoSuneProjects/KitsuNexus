# Copy this file to .env and fill in real values. Never commit the real .env.

# The official NekoSuneAPPS deployment uses the same application as the locked
# Rich Presence ID (DEFAULT_DISCORD_APP_ID / DISCORD_APP_ID in the Electron
# app), since Discord Activities are configured per-application and that's the
# app the Activities URL Mapping lives on. Self-hosters do NOT need to match
# this — create your own Discord application instead and put its ID here (also
# update CLIENT_ID in public/activity/app.js to match if you use the Activity).
DISCORD_CLIENT_ID=1534167604304937142

# From the Developer Portal (OAuth2 tab) for whichever application ID you used above.
# Lives ONLY here — never in the Electron app.
DISCORD_CLIENT_SECRET=

# The shared/official bot's token. Lives ONLY here — never in the Electron app.
DISCORD_BOT_TOKEN=

# Must exactly match a redirect registered in the Developer Portal's OAuth2 tab.
# The official deployment uses https://nekosuneappsvrc.nekosunevr.co.uk — self-hosters
# should use their own domain and point the Electron app's Backend URL setting at it.
DISCORD_REDIRECT_URI=https://your-chosen-host.example.com/oauth2/discord/callback

# Signs this backend's own short-lived session tokens. Generate a long random value,
# e.g. `openssl rand -hex 32` — rotating it invalidates every issued session token.
JWT_SECRET=

# Session token lifetime (jsonwebtoken "expiresIn" format).
JWT_TTL=12h

PORT=8080

# Optional. GET / redirects here (e.g. your Discord server's invite link) —
# left blank, / just serves a plain placeholder page instead.
DISCORD_INVITE_URL=
